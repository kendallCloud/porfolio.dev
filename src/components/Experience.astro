---
import ExperienceItem from "./ExperienceItem.astro"
const EXPERIENCE = [
  {
    date: "February 2024 - April 2025",
    title: "Full Stack Software Engineer",
    company: "Ticoder (Tavuel)",
    description:
      "Delivered 36 tickets and 96 pull requests, focusing on legacy system modernization for financial and electronic invoicing applications. Led technology migration initiatives to improve system efficiency and user experience, including database schema redesigns and UI/UX enhancements. Developed and maintained full-stack solutions using MySQL, Node.js, GraphQL, React.js, and SCSS, ensuring seamless integration between frontend and backend systems.",
  },
  {
    date: "2023",
    title: "Full Stack Software Engineer",
    company: "BIU Supply MX",
    description:
      "Designed and implemented comprehensive backend systems and database architecture using MySQL and Prisma ORM, supporting product tracking and order management workflows. Developed automated features for product tracking systems, ensuring data consistency and accuracy across all product and order information with high reliability. Built scalable web applications using Node.js framework integrated with AWS cloud services, optimizing performance for high-volume e-commerce operations.",
  },
];
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
